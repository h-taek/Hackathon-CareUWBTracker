# 서버 설정 — 이 파일을 같은 폴더에 `.env`로 복사한 뒤 필요한 줄의 주석을 풀어 값을 넣는다.
#
#   cp server/.env.example server/.env        (Windows: copy server\.env.example server\.env)
#
# `server/.env`가 없으면 아래의 기본값으로 동작한다. 셸에서 직접 지정한 환경 변수가
# 이 파일보다 우선하므로, 한 번만 다르게 띄울 때는 파일을 고치지 않아도 된다.
#
# 값은 따옴표 없이 적는다. 경로에 공백이 있어도 그대로 적는다.
# **상대 경로는 이 파일이 아니라 명령을 실행한 위치(저장소 최상위) 기준으로 풀린다.**


# ── 서버 ────────────────────────────────────────────────────────────────
# 대시보드와 API가 열리는 포트. 8080이 이미 쓰이는 환경에서 바꾼다.
#PORT=8080

# 사고 기록, 명부, 확인자료, 반출 큐가 쌓이는 최상위 디렉터리.
#DATA_DIR=server/data


# ── 관제사 세션 ─────────────────────────────────────────────────────────
# 관제 세션의 수명(시간). 마지막 조작이 아니라 발급 시각부터 재는 절대 만료다.
# 기본 3시간은 한 교대를 넘기지 않는 길이다.
# 소수를 받는다 — 0.01은 36초다. 만료 팝업과 `연장`을 기다리지 않고 확인할 때 쓴다.
# 0 이하나 숫자가 아닌 값은 기본값으로 돌린다.
#SESSION_TTL_HOURS=3


# ── 사고 기록 ───────────────────────────────────────────────────────────
# 경보 시각을 기준으로 기록에 담을 앞뒤 구간(밀리초).
# 앞 구간은 접근 동선이, 뒤 구간은 넘어진 뒤의 정지가 보이는 길이다.
# 뒤 구간이 차야 기록이 확정되므로, 줄이면 시연에서 덜 기다린다.
#EVENT_PRE_MS=10000
#EVENT_POST_MS=10000

# 현장 영상 업로드 한도(MB). 아이폰 4K 30fps가 분당 약 310MB다.
#ATTACHMENT_LIMIT_MB=2048


# ── 보관·파기 ───────────────────────────────────────────────────────────
# 감지 이벤트를 며칠이 아니라 몇 시간 두는지. 판정을 번복할 수 있는 창이기도 하다.
# 소수를 받는다 — 0.02는 72초다. 24시간짜리 자동 파기를 즉시 확인할 때 쓴다.
#UNDO_WINDOW_HOURS=24

# 파기 검사를 도는 주기(시간). 위와 같이 낮춰야 파기가 실제로 실행된다.
#SWEEP_INTERVAL_HOURS=24

# 판정이 '낙상'인 확인 사건의 보관 기간(일). 기본은 3년이다.
#INCIDENT_RETENTION_DAYS=1095

# 1이면 무엇을 지울지 로그로만 남기고 실제로 지우지 않는다.
#RETENTION_DRY_RUN=0


# ── 학습 데이터 반출 ────────────────────────────────────────────────────
# 수집 서버 주소. **비워 두면 전송하지 않고 큐에만 쌓는다(기본 비활성).**
# 동봉된 수신 목업으로 왕복을 확인하려면 아래 값을 쓴다.
#EXPORT_URL=http://localhost:9100/samples

# 지정하면 `Authorization: Bearer <값>` 헤더를 붙인다.
# 반출물 본문에는 시설 식별자가 들어가지 않는다 — 인증은 헤더로만 한다.
#EXPORT_TOKEN=

# 전송을 마친 배치를 며칠 두었다가 지울지.
#EXPORT_KEEP_DAYS=7


# ── 낙상 판정 ───────────────────────────────────────────────────────────
# 0이면 LightGBM 정밀 판정을 끄고 고전 상태머신 단독으로 동작한다.
#FALL_AI=1

# 고전 감지기의 임계값. 충격 판정 기준(g), 자유낙하 기준(g)과 그 관측 창(ms),
# 정점 이후 판정을 확정하기까지의 지연(ms), 같은 태그의 재발화 억제 시간(ms).
#FALL_IMPACT_G=2.5
#FALL_FREEFALL_G=0.6
#FALL_FREEFALL_WINDOW_MS=1000
#FALL_DECISION_DELAY_MS=1500
#FALL_COOLDOWN_MS=5000


# ── 마커 떨림 억제 ──────────────────────────────────────────────────────
# UWB 거리는 제자리에 서 있어도 수 cm씩 흔들린다. 떨림이 남으면 데드밴드를 올리고,
# 마커가 굼뜨면 내린다.
#POS_WINDOW=5                 이동평균 창(프레임)
#POS_DEADBAND_M=0.4           정지로 보고 좌표를 고정하는 반경(m)
#POS_DEADBAND_MOVING_M=0.15   0.3초 동안 이만큼도 못 움직이면 정지로 판정(m)
#POS_MAX_JUMP_M=0.8           이상치로 버리는 기준 거리(m)
#POS_MAX_SPEED_MPS=3          이상치 판정에 더하는 속도 몫(m/s)


# ── 3D 재구성 (선택) ────────────────────────────────────────────────────
# 0이면 영상을 올려도 재구성을 자동으로 걸지 않는다.
# 도구가 하나라도 없으면 이 값과 무관하게 자동 실행이 꺼진다.
#RECON_AUTO=1

# 실행 파일이 PATH에 없거나 다른 자리에 있을 때 지정한다.
#FFMPEG_BIN=ffmpeg
#FFPROBE_BIN=ffprobe
#COLMAP_BIN=colmap
#OPENSPLAT_BIN=opensplat

# 추출할 프레임 수, 프레임 가로 픽셀(0이면 원본), 3DGS 학습 반복 수,
# COLMAP 특징 추출·매칭의 GPU 사용 여부(0이면 CPU).
# 기본값은 전부 상류 프로젝트 그대로다. 급하면 관제 화면에서 실행마다 낮춘다.
#RECON_FRAMES=300
#RECON_FRAME_WIDTH=0
#RECON_ITERS=30000
#RECON_GPU=1


# ── 반출 수신 목업 (npm run export-sink) ────────────────────────────────
# 제품이 아니라 전송 왕복을 눈으로 확인하기 위한 목업 서버다. 서버 설정은 아니지만
# 이 파일에 함께 둔다 — 아래 토큰은 위의 EXPORT_TOKEN과 짝을 맞춰야 하고,
# 두 파일로 갈라 두면 그 대조가 어려워진다.
#SINK_PORT=9100
#SINK_DIR=tools/sink-out
# 지정하면 이 값과 일치하는 Bearer 토큰만 받는다. 전송이 막히는 자리를 볼 때 쓴다.
#SINK_TOKEN=
